# cp .env.local.example .env.local
#
# ローカル開発用（1Password は不要）。
# ログインは Supabase Auth（Google）。Supabase プロジェクトは開発用と本番用で分ける。
# 開発用の値（project-url / publishable-key）は 1Password を経由せず、ここへ直接書く。
# 開発用 Supabase の Redirect URLs: https://<TUNNEL_HOSTNAME>/auth/callback

DB_NAME=app_signaly
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

SUPABASE_URL=https://<開発用プロジェクト>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
APP_URL=https://dev.example.com/
TUNNEL_NAME=dev-tunnel           # scripts/setup-tunnel.sh で設定（複数プロジェクト共有の場合は共通名にする）
TUNNEL_HOSTNAME=dev.example.com  # 固定トンネル URL（未設定時は Quick Tunnel）

ALLOWED_EMAILS=you@gmail.com,other@gmail.com
SECRET_KEY=  # SSE 用セッション Cookie の署名。python -c "import secrets; print(secrets.token_hex(32))" で生成

# ログイン通知（任意。未設定なら通知しない）
# 共有 Supabase プロジェクトの Database Webhooks はどのアプリへのログインかを
# 区別できないため、Signaly 自身のログインはここへ POST する。
SIGNALY_LOGIN_WEBHOOK_URL=

# Web Push（スマホ常時通知。任意）
# python scripts/gen_vapid_keys.py mailto:you@gmail.com の出力を追加
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@gmail.com
